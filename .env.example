# GEMINI_API_KEY: Required for Gemini AI API calls (AI Form Builder & Zacma AI Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and public form URLs.
APP_URL="MY_APP_URL"

# Optional External Communication Providers (Enable ONLY after Super Admin approval)
# Email provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS provider (Twilio - International)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS provider (AfroMessage - Ethiopia local SMS optional alternative)
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_SENDER_ID=
AFROMESSAGE_IDENTIFIER_ID=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional Firebase Web SDK Overrides for Vercel Production / Preview Deployments
# (Defaults are loaded automatically from firebase-applet-config.json; only public client keys belong here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

