        "status": { "type": "string", "enum": ["active", "inactive"] },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorizedUserIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "name", "slug", "description", "category", "services", "logoUrl", "brandColor", "contactEmail", "phoneNumber", "physicalAddress", "website", "assignedAdminIds", "assignedStaffIds", "status", "ownerId", "authorizedUserIds", "createdAt", "updatedAt"]
    },
