  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and default organization reference (PII isolated to owner or Super Admin)."
    },
    "/publicForms/{publicSlugKey}": {
      "schema": { "$ref": "#/entities/PublicFormProjection" },
      "description": "Sanitized public-facing form schemas readable by exact slug key when published and active."
    },
    "/organizations/{organizationId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Root tenant organization records."
    },
    "/organizations/{organizationId}/members/{userId}": {
      "schema": { "$ref": "#/entities/OrganizationMember" },
      "description": "RBAC role and business unit membership records."
    },
    "/organizations/{organizationId}/businessUnits/{businessUnitId}": {
      "schema": { "$ref": "#/entities/BusinessUnit" },
      "description": "Dynamic business units managed by the organization."
    },
    "/organizations/{organizationId}/businessUnits/{businessUnitId}/forms/{formId}": {
      "schema": { "$ref": "#/entities/DynamicForm" },
      "description": "Business-unit-specific AI-generated and custom dynamic forms."
    },
    "/organizations/{organizationId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Centralized CRM leads extracted from forms or created by authorized staff."
    },
    "/organizations/{organizationId}/leads/{leadId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/LeadActivity" },
      "description": "Chronological audit timeline of lead actions."
    },
    "/organizations/{organizationId}/leads/{leadId}/communications/{communicationId}": {
      "schema": { "$ref": "#/entities/CommunicationRecord" },
      "description": "Individual and bulk SMS/Email communication history per lead."
    },
