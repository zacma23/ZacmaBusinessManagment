{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Zacma user profile and default organization binding.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "organizationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["super_admin", "org_admin", "bu_manager", "staff", "accountant", "instructor"] },
        "crmAccess": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "organizationId", "role", "crmAccess", "createdAt", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Top-level Zacma tenant organization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "primaryColor": { "type": "string", "maxLength": 20 },
        "secondaryColor": { "type": "string", "maxLength": 20 },
        "duplicateMatchMode": { "type": "string", "enum": ["email_or_phone", "email_only", "phone_only", "email_and_phone"] },
        "authorizedUserIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "ownerId", "primaryColor", "secondaryColor", "duplicateMatchMode", "authorizedUserIds", "createdAt", "updatedAt"]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "Role-based access membership record within an organization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizationId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "org_admin", "bu_manager", "staff", "accountant", "instructor"] },
        "crmAccess": { "type": "boolean" },
        "assignedBusinessUnitIds": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive", "invited"] },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorizedUserIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "organizationId", "email", "displayName", "role", "crmAccess", "assignedBusinessUnitIds", "status", "ownerId", "authorizedUserIds", "createdAt", "updatedAt"]
    },
    "BusinessUnit": {
      "title": "BusinessUnit",
