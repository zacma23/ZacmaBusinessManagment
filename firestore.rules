rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & IDENTITY HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 90 && slug.matches('^[a-z0-9\\-]+$');
    }

    function isValidPublicKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 180 && key.matches('^[a-z0-9_\\-]+$');
    }

    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 40 && u.matches('^[a-z0-9._\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'zekimuluken@gmail.com';
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function hasMemberDoc(orgId) {
      return isSignedIn() && exists(memberPath(orgId, request.auth.uid));
    }

    function getMemberRole(orgId) {
      return get(memberPath(orgId, request.auth.uid)).data.role;
    }

    function isMemberActive(orgId) {
      return hasMemberDoc(orgId) && get(memberPath(orgId, request.auth.uid)).data.status == 'active';
    }

    function isOrgSuperOrAdmin(orgId) {
      return isBootstrapSuperAdmin() || (
        isMemberActive(orgId) && (getMemberRole(orgId) == 'super_admin' || getMemberRole(orgId) == 'org_admin')
      );
    }

    function isBuManagerFor(orgId, buId) {
      return isMemberActive(orgId) &&
        getMemberRole(orgId) == 'bu_manager' &&
        buId in get(memberPath(orgId, request.auth.uid)).data.assignedBusinessUnitIds;
    }

    function isStaffForOrg(orgId) {
      return isBootstrapSuperAdmin() || (
        isMemberActive(orgId) && (
          getMemberRole(orgId) == 'staff' ||
          getMemberRole(orgId) == 'bu_manager' ||
          getMemberRole(orgId) == 'org_admin' ||
          getMemberRole(orgId) == 'super_admin' ||
          get(memberPath(orgId, request.auth.uid)).data.crmAccess == true
        )
      );
    }

    function canReadOrgRecord(data) {
      return isBootstrapSuperAdmin() || (
        isSignedIn() && (
          data.ownerId == request.auth.uid ||
          request.auth.uid in data.authorizedUserIds
        )
      );
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP)
    // =========================================================================

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'organizationId', 'role', 'crmAccess', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'username', 'phone', 'authProvider', 'mustChangePassword', 'status', 'lastLoginAt', 'organizationId', 'role', 'crmAccess', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isBoundedString(data.email, 200) &&
        isBoundedString(data.displayName, 120) &&
        (!('photoURL' in data) || isBoundedString(data.photoURL, 500)) &&
        (!('username' in data) || data.username == '' || isValidUsername(data.username)) &&
        (!('phone' in data) || isBoundedString(data.phone, 60)) &&
        (!('authProvider' in data) || data.authProvider in ['google', 'username_password']) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool) &&
        (!('status' in data) || data.status in ['active', 'inactive', 'suspended']) &&
        (!('lastLoginAt' in data) || isBoundedString(data.lastLoginAt, 40)) &&
        isValidId(data.organizationId) &&
        data.role in ['super_admin', 'org_admin', 'bu_manager', 'staff', 'accountant', 'instructor', 'student'] &&
        data.crmAccess is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrganization(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'ownerId', 'primaryColor', 'secondaryColor', 'duplicateMatchMode', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'ownerId', 'primaryColor', 'secondaryColor', 'duplicateMatchMode', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.name, 140) &&
        isValidSlug(data.slug) &&
        isValidId(data.ownerId) &&
        isBoundedString(data.primaryColor, 20) &&
        isBoundedString(data.secondaryColor, 20) &&
        data.duplicateMatchMode in ['email_or_phone', 'email_only', 'phone_only', 'email_and_phone'] &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrgMember(data) {
      return data.keys().hasAll(['userId', 'organizationId', 'email', 'displayName', 'role', 'crmAccess', 'assignedBusinessUnitIds', 'status', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'organizationId', 'email', 'username', 'phone', 'displayName', 'role', 'crmAccess', 'permissions', 'authProvider', 'mustChangePassword', 'lastLoginAt', 'assignedBusinessUnitIds', 'status', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        isValidId(data.organizationId) &&
        isBoundedString(data.email, 200) &&
        (!('username' in data) || data.username == '' || isValidUsername(data.username)) &&
        (!('phone' in data) || isBoundedString(data.phone, 60)) &&
        isBoundedString(data.displayName, 120) &&
        data.role in ['super_admin', 'org_admin', 'bu_manager', 'staff', 'accountant', 'instructor', 'student'] &&
        data.crmAccess is bool &&
        (!('permissions' in data) || data.permissions is map) &&
        (!('authProvider' in data) || data.authProvider in ['google', 'username_password']) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool) &&
        (!('lastLoginAt' in data) || isBoundedString(data.lastLoginAt, 40)) &&
        isBoundedStringList(data.assignedBusinessUnitIds, 50) &&
        data.status in ['active', 'inactive', 'invited', 'suspended'] &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUsernameLookup(data) {
      return data.keys().hasAll(['username', 'loginEmail', 'uid', 'organizationId', 'status', 'ownerId', 'authorizedUserIds', 'updatedAt']) &&
        data.keys().hasOnly(['username', 'loginEmail', 'uid', 'organizationId', 'status', 'ownerId', 'authorizedUserIds', 'updatedAt']) &&
        isValidUsername(data.username) &&
        isNonEmptyString(data.loginEmail, 200) &&
        isValidId(data.uid) &&
        isValidId(data.organizationId) &&
        data.status in ['active', 'inactive', 'suspended'] &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.updatedAt is timestamp;
    }

    function isValidLoginActivity(data) {
      return data.keys().hasAll(['id', 'organizationId', 'userId', 'username', 'email', 'displayName', 'role', 'authMethod', 'eventType', 'userAgent', 'domain', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'userId', 'username', 'email', 'displayName', 'role', 'authMethod', 'eventType', 'userAgent', 'domain', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.userId) &&
        isBoundedString(data.username, 60) &&
        isBoundedString(data.email, 200) &&
        isBoundedString(data.displayName, 120) &&
        data.role in ['super_admin', 'org_admin', 'bu_manager', 'staff', 'accountant', 'instructor', 'student'] &&
        data.authMethod in ['google', 'username_password'] &&
        data.eventType in ['login', 'logout', 'password_change', 'password_reset_requested'] &&
        isBoundedString(data.userAgent, 260) &&
        isBoundedString(data.domain, 160) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidBusinessUnit(data) {
      return data.keys().hasAll(['id', 'organizationId', 'name', 'slug', 'description', 'category', 'services', 'logoUrl', 'brandColor', 'contactEmail', 'phoneNumber', 'physicalAddress', 'website', 'assignedAdminIds', 'assignedStaffIds', 'status', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'name', 'slug', 'description', 'category', 'services', 'logoUrl', 'brandColor', 'contactEmail', 'phoneNumber', 'physicalAddress', 'website', 'assignedAdminIds', 'assignedStaffIds', 'status', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isNonEmptyString(data.name, 140) &&
        isValidSlug(data.slug) &&
        isBoundedString(data.description, 1500) &&
        isBoundedString(data.category, 100) &&
        isBoundedStringList(data.services, 40) &&
        isBoundedString(data.logoUrl, 250000) &&
        isBoundedString(data.brandColor, 20) &&
        isBoundedString(data.contactEmail, 200) &&
        isBoundedString(data.phoneNumber, 50) &&
        isBoundedString(data.physicalAddress, 300) &&
        isBoundedString(data.website, 300) &&
        isBoundedStringList(data.assignedAdminIds, 30) &&
        isBoundedStringList(data.assignedStaffIds, 60) &&
        data.status in ['active', 'inactive'] &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDynamicForm(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'businessUnitSlug', 'businessUnitName', 'title', 'slug', 'publicSlugKey', 'description', 'fields', 'isPublished', 'isActive', 'submissionLimit', 'submissionCount', 'confirmationMessage', 'brandColor', 'logoUrl', 'aiPrompt', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'businessUnitSlug', 'businessUnitName', 'title', 'slug', 'publicSlugKey', 'description', 'fields', 'isPublished', 'isActive', 'submissionLimit', 'submissionCount', 'confirmationMessage', 'brandColor', 'logoUrl', 'aiPrompt', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.businessUnitId) &&
        isValidSlug(data.businessUnitSlug) &&
        isNonEmptyString(data.businessUnitName, 140) &&
        isNonEmptyString(data.title, 180) &&
        isValidSlug(data.slug) &&
        isValidPublicKey(data.publicSlugKey) &&
        isBoundedString(data.description, 1500) &&
        data.fields is list && data.fields.size() <= 80 &&
        data.isPublished is bool &&
        data.isActive is bool &&
        data.submissionLimit is number && data.submissionLimit >= 0 && data.submissionLimit <= 1000000 &&
        data.submissionCount is number && data.submissionCount >= 0 && data.submissionCount <= 10000000 &&
        isBoundedString(data.confirmationMessage, 1000) &&
        isBoundedString(data.brandColor, 20) &&
        isBoundedString(data.logoUrl, 250000) &&
        isBoundedString(data.aiPrompt, 2000) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicFormProjection(data) {
      return data.keys().hasAll(['publicSlugKey', 'organizationId', 'businessUnitId', 'businessUnitSlug', 'businessUnitName', 'formId', 'formSlug', 'title', 'description', 'fields', 'isPublished', 'isActive', 'submissionLimit', 'confirmationMessage', 'brandColor', 'logoUrl', 'orgOwnerId', 'updatedAt']) &&
        data.keys().hasOnly(['publicSlugKey', 'organizationId', 'businessUnitId', 'businessUnitSlug', 'businessUnitName', 'formId', 'formSlug', 'title', 'description', 'fields', 'isPublished', 'isActive', 'submissionLimit', 'confirmationMessage', 'brandColor', 'logoUrl', 'orgOwnerId', 'updatedAt']) &&
        isValidPublicKey(data.publicSlugKey) &&
        isValidId(data.organizationId) &&
        isValidId(data.businessUnitId) &&
        isValidSlug(data.businessUnitSlug) &&
        isNonEmptyString(data.businessUnitName, 140) &&
        isValidId(data.formId) &&
        isValidSlug(data.formSlug) &&
        isNonEmptyString(data.title, 180) &&
        isBoundedString(data.description, 1500) &&
        data.fields is list && data.fields.size() <= 80 &&
        data.isPublished is bool &&
        data.isActive is bool &&
        data.submissionLimit is number && data.submissionLimit >= 0 &&
        isBoundedString(data.confirmationMessage, 1000) &&
        isBoundedString(data.brandColor, 20) &&
        isBoundedString(data.logoUrl, 250000) &&
        isValidId(data.orgOwnerId) &&
        data.updatedAt is timestamp;
    }

    function isValidFormSubmission(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'businessUnitName', 'formId', 'formTitle', 'publicSlugKey', 'leadId', 'leadRef', 'responses', 'submitterName', 'submitterEmail', 'submitterPhone', 'source', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'businessUnitName', 'formId', 'formTitle', 'publicSlugKey', 'leadId', 'leadRef', 'responses', 'submitterName', 'submitterEmail', 'submitterPhone', 'source', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.businessUnitId) &&
        isNonEmptyString(data.businessUnitName, 140) &&
        isValidId(data.formId) &&
        isNonEmptyString(data.formTitle, 180) &&
        isValidPublicKey(data.publicSlugKey) &&
        isValidId(data.leadId) &&
        isNonEmptyString(data.leadRef, 40) &&
        data.responses is map &&
        isBoundedString(data.submitterName, 160) &&
        isBoundedString(data.submitterEmail, 200) &&
        isBoundedString(data.submitterPhone, 60) &&
        data.source in ['public_form', 'manual_entry', 'portal_preview'] &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'leadRef', 'organizationId', 'businessUnitId', 'businessUnitName', 'formId', 'formTitle', 'submissionId', 'publicSlugKey', 'fullName', 'email', 'phone', 'responses', 'source', 'assignedStaffId', 'assignedStaffName', 'status', 'priority', 'followUpDate', 'lastContactAt', 'internalNotes', 'attachments', 'ownerId', 'authorizedUserIds', 'submittedAt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'leadRef', 'organizationId', 'businessUnitId', 'businessUnitName', 'formId', 'formTitle', 'submissionId', 'publicSlugKey', 'fullName', 'email', 'phone', 'responses', 'source', 'assignedStaffId', 'assignedStaffName', 'status', 'priority', 'followUpDate', 'lastContactAt', 'internalNotes', 'attachments', 'ownerId', 'authorizedUserIds', 'submittedAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.leadRef, 40) &&
        isValidId(data.organizationId) &&
        isValidId(data.businessUnitId) &&
        isNonEmptyString(data.businessUnitName, 140) &&
        isBoundedString(data.formId, 128) &&
        isBoundedString(data.formTitle, 180) &&
        isBoundedString(data.submissionId, 128) &&
        isBoundedString(data.publicSlugKey, 180) &&
        isBoundedString(data.fullName, 160) &&
        isBoundedString(data.email, 200) &&
        isBoundedString(data.phone, 60) &&
        data.responses is map &&
        isBoundedString(data.source, 80) &&
        isBoundedString(data.assignedStaffId, 128) &&
        isBoundedString(data.assignedStaffName, 120) &&
        data.status in ['new', 'contacted', 'interested', 'converted', 'lost', 'archived'] &&
        data.priority in ['low', 'medium', 'high', 'urgent'] &&
        isBoundedString(data.followUpDate, 40) &&
        isBoundedString(data.lastContactAt, 40) &&
        isBoundedString(data.internalNotes, 5000) &&
        data.attachments is list && data.attachments.size() <= 20 &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.submittedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeadActivity(data) {
      return data.keys().hasAll(['id', 'organizationId', 'leadId', 'type', 'summary', 'details', 'actorId', 'actorName', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'leadId', 'type', 'summary', 'details', 'actorId', 'actorName', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.leadId) &&
        data.type in ['submission', 'status_change', 'assignment', 'note', 'call', 'meeting', 'followup', 'communication', 'archive', 'restore', 'edit'] &&
        isNonEmptyString(data.summary, 500) &&
        isBoundedString(data.details, 2000) &&
        isBoundedString(data.actorId, 128) &&
        isBoundedString(data.actorName, 120) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidCommunication(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'leadId', 'leadName', 'channel', 'recipient', 'subject', 'body', 'deliveryStatus', 'provider', 'senderId', 'senderName', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'leadId', 'leadName', 'channel', 'recipient', 'subject', 'body', 'deliveryStatus', 'provider', 'senderId', 'senderName', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isBoundedString(data.businessUnitId, 128) &&
        isValidId(data.leadId) &&
        isBoundedString(data.leadName, 160) &&
        data.channel in ['email', 'sms'] &&
        isNonEmptyString(data.recipient, 200) &&
        isBoundedString(data.subject, 250) &&
        isNonEmptyString(data.body, 5000) &&
        data.deliveryStatus in ['sent', 'queued_pending_provider_approval', 'failed'] &&
        isBoundedString(data.provider, 60) &&
        isValidId(data.senderId) &&
        isBoundedString(data.senderName, 120) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidMessageTemplate(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'name', 'channel', 'subject', 'body', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'name', 'channel', 'subject', 'body', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isBoundedString(data.businessUnitId, 128) &&
        isNonEmptyString(data.name, 140) &&
        data.channel in ['email', 'sms'] &&
        isBoundedString(data.subject, 250) &&
        isNonEmptyString(data.body, 5000) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffAssignment(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'userId', 'role', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'userId', 'role', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.businessUnitId) &&
        isValidId(data.userId) &&
        data.role in ['bu_manager', 'staff'] &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'organizationId', 'recipientUserId', 'title', 'message', 'entityType', 'entityId', 'isRead', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'recipientUserId', 'title', 'message', 'entityType', 'entityId', 'isRead', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.recipientUserId) &&
        isNonEmptyString(data.title, 180) &&
        isNonEmptyString(data.message, 500) &&
        data.entityType in ['lead', 'form', 'followup', 'integration'] &&
        isBoundedString(data.entityId, 128) &&
        data.isRead is bool &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'organizationId', 'actorId', 'actorName', 'action', 'resourceType', 'resourceId', 'summary', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'actorId', 'actorName', 'action', 'resourceType', 'resourceId', 'summary', 'ownerId', 'authorizedUserIds', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isValidId(data.actorId) &&
        isBoundedString(data.actorName, 120) &&
        isNonEmptyString(data.action, 100) &&
        isNonEmptyString(data.resourceType, 80) &&
        isBoundedString(data.resourceId, 128) &&
        isNonEmptyString(data.summary, 500) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp;
    }

    function isValidIntegrationConfig(data) {
      return data.keys().hasAll(['id', 'organizationId', 'providerKey', 'displayName', 'purpose', 'requiredCredentials', 'estimatedCost', 'approvalStatus', 'approvedBy', 'ownerId', 'authorizedUserIds', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'providerKey', 'displayName', 'purpose', 'requiredCredentials', 'estimatedCost', 'approvalStatus', 'approvedBy', 'ownerId', 'authorizedUserIds', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        data.providerKey in ['gemini_ai', 'resend_email', 'twilio_sms', 'whatsapp_cloud'] &&
        isNonEmptyString(data.displayName, 120) &&
        isNonEmptyString(data.purpose, 500) &&
        isBoundedStringList(data.requiredCredentials, 10) &&
        isBoundedString(data.estimatedCost, 300) &&
        data.approvalStatus in ['enabled', 'pending_approval', 'approved_awaiting_env', 'disabled'] &&
        isBoundedString(data.approvedBy, 128) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.updatedAt is timestamp;
    }

    function isValidPublicSupportConfig(data) {
      return data.keys().hasAll(['organizationId', 'isActive', 'assistantName', 'welcomeMessage', 'aiInstructions', 'supportedLanguages', 'trainingInstituteBuId', 'trainingInstituteName', 'registrationFormUrl', 'orgOwnerId', 'updatedAt']) &&
        data.keys().hasOnly(['organizationId', 'isActive', 'assistantName', 'welcomeMessage', 'aiInstructions', 'supportedLanguages', 'trainingInstituteBuId', 'trainingInstituteName', 'registrationFormUrl', 'orgOwnerId', 'updatedAt']) &&
        isValidId(data.organizationId) &&
        data.isActive is bool &&
        isNonEmptyString(data.assistantName, 100) &&
        isNonEmptyString(data.welcomeMessage, 1000) &&
        isBoundedString(data.aiInstructions, 3000) &&
        isBoundedStringList(data.supportedLanguages, 10) &&
        isBoundedString(data.trainingInstituteBuId, 128) &&
        isBoundedString(data.trainingInstituteName, 160) &&
        isBoundedString(data.registrationFormUrl, 500) &&
        isValidId(data.orgOwnerId) &&
        data.updatedAt is timestamp;
    }

    function isValidTrainingCourse(data) {
      return data.keys().hasAll(['id', 'organizationId', 'title', 'category', 'description', 'learningObjectives', 'qualifications', 'duration', 'deliveryMethods', 'schedules', 'availableBatches', 'certificateInfo', 'approvedFee', 'registrationProcedure', 'isActive', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'title', 'category', 'description', 'learningObjectives', 'qualifications', 'duration', 'deliveryMethods', 'schedules', 'availableBatches', 'certificateInfo', 'approvedFee', 'registrationProcedure', 'isActive', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isNonEmptyString(data.title, 160) &&
        isBoundedString(data.category, 100) &&
        isBoundedString(data.description, 2000) &&
        isBoundedStringList(data.learningObjectives, 20) &&
        isBoundedString(data.qualifications, 600) &&
        isBoundedString(data.duration, 120) &&
        isBoundedStringList(data.deliveryMethods, 10) &&
        isBoundedString(data.schedules, 600) &&
        isBoundedString(data.availableBatches, 600) &&
        isBoundedString(data.certificateInfo, 600) &&
        isBoundedString(data.approvedFee, 200) &&
        isBoundedString(data.registrationProcedure, 1000) &&
        data.isActive is bool &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupportKnowledge(data) {
      return data.keys().hasAll(['id', 'organizationId', 'category', 'question', 'answer', 'language', 'isActive', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'category', 'question', 'answer', 'language', 'isActive', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        data.category in ['registration', 'payment', 'schedule', 'location', 'attendance', 'certificates', 'materials', 'student_services', 'general'] &&
        isNonEmptyString(data.question, 400) &&
        isNonEmptyString(data.answer, 3000) &&
        data.language in ['en', 'am', 'both'] &&
        data.isActive is bool &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupportConversation(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'visitorName', 'visitorPhone', 'visitorEmail', 'studentUid', 'language', 'intent', 'interestedCourse', 'status', 'assignedAgentId', 'assignedAgentName', 'unansweredQuestions', 'leadId', 'leadRef', 'messages', 'summary', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'visitorName', 'visitorPhone', 'visitorEmail', 'studentUid', 'language', 'intent', 'interestedCourse', 'status', 'assignedAgentId', 'assignedAgentName', 'unansweredQuestions', 'leadId', 'leadRef', 'messages', 'summary', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isBoundedString(data.businessUnitId, 128) &&
        isBoundedString(data.visitorName, 160) &&
        isBoundedString(data.visitorPhone, 60) &&
        isBoundedString(data.visitorEmail, 200) &&
        isBoundedString(data.studentUid, 128) &&
        data.language in ['en', 'am', 'other'] &&
        data.intent in ['course_inquiry', 'registration', 'student_support', 'escalation', 'general'] &&
        isBoundedString(data.interestedCourse, 160) &&
        data.status in ['active', 'escalated', 'assigned', 'resolved'] &&
        isBoundedString(data.assignedAgentId, 128) &&
        isBoundedString(data.assignedAgentName, 120) &&
        isBoundedStringList(data.unansweredQuestions, 30) &&
        isBoundedString(data.leadId, 128) &&
        isBoundedString(data.leadRef, 40) &&
        data.messages is list && data.messages.size() <= 120 &&
        isBoundedString(data.summary, 1000) &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentRegistration(data) {
      return data.keys().hasAll(['id', 'organizationId', 'businessUnitId', 'leadId', 'leadRef', 'studentUid', 'fullName', 'phone', 'email', 'address', 'preferredCourse', 'deliveryMethod', 'preferredSchedule', 'paymentMethod', 'registrationStatus', 'batchName', 'classSchedule', 'trainingLocation', 'paymentStatus', 'certificateStatus', 'documentUploadFormUrl', 'source', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'organizationId', 'businessUnitId', 'leadId', 'leadRef', 'studentUid', 'fullName', 'phone', 'email', 'address', 'preferredCourse', 'deliveryMethod', 'preferredSchedule', 'paymentMethod', 'registrationStatus', 'batchName', 'classSchedule', 'trainingLocation', 'paymentStatus', 'certificateStatus', 'documentUploadFormUrl', 'source', 'ownerId', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        isBoundedString(data.businessUnitId, 128) &&
        isBoundedString(data.leadId, 128) &&
        isNonEmptyString(data.leadRef, 40) &&
        isBoundedString(data.studentUid, 128) &&
        isNonEmptyString(data.fullName, 160) &&
        isNonEmptyString(data.phone, 60) &&
        isBoundedString(data.email, 200) &&
        isBoundedString(data.address, 300) &&
        isNonEmptyString(data.preferredCourse, 160) &&
        isBoundedString(data.deliveryMethod, 80) &&
        isBoundedString(data.preferredSchedule, 120) &&
        isBoundedString(data.paymentMethod, 120) &&
        data.registrationStatus in ['submitted', 'under_review', 'approved', 'enrolled', 'completed'] &&
        isBoundedString(data.batchName, 120) &&
        isBoundedString(data.classSchedule, 200) &&
        isBoundedString(data.trainingLocation, 200) &&
        data.paymentStatus in ['pending', 'partial', 'paid'] &&
        data.certificateStatus in ['not_issued', 'in_progress', 'issued'] &&
        isBoundedString(data.documentUploadFormUrl, 500) &&
        data.source in ['ai_chat', 'public_form', 'portal'] &&
        isValidId(data.ownerId) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSaasPlan(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'audience', 'tagline', 'monthlyPriceEtb', 'monthlyPriceUsd', 'annualDiscountPercent', 'maxBusinessUnits', 'maxForms', 'maxLeads', 'maxStaffSeats', 'includesAiSupport', 'includesSmsEmailAi', 'includesWhiteLabel', 'features', 'isRecommended', 'isActive', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'audience', 'tagline', 'monthlyPriceEtb', 'monthlyPriceUsd', 'annualDiscountPercent', 'maxBusinessUnits', 'maxForms', 'maxLeads', 'maxStaffSeats', 'includesAiSupport', 'includesSmsEmailAi', 'includesWhiteLabel', 'features', 'isRecommended', 'isActive', 'sortOrder', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidPublicKey(data.code) &&
        isNonEmptyString(data.name, 100) &&
        isBoundedString(data.audience, 140) &&
        isBoundedString(data.tagline, 240) &&
        data.monthlyPriceEtb is number && data.monthlyPriceEtb >= 0 && data.monthlyPriceEtb <= 10000000 &&
        data.monthlyPriceUsd is number && data.monthlyPriceUsd >= 0 && data.monthlyPriceUsd <= 100000 &&
        data.annualDiscountPercent is number && data.annualDiscountPercent >= 0 && data.annualDiscountPercent <= 90 &&
        data.maxBusinessUnits is number && data.maxBusinessUnits >= 1 && data.maxBusinessUnits <= 10000 &&
        data.maxForms is number && data.maxForms >= 1 && data.maxForms <= 100000 &&
        data.maxLeads is number && data.maxLeads >= 1 && data.maxLeads <= 10000000 &&
        data.maxStaffSeats is number && data.maxStaffSeats >= 1 && data.maxStaffSeats <= 10000 &&
        data.includesAiSupport is bool &&
        data.includesSmsEmailAi is bool &&
        data.includesWhiteLabel is bool &&
        isBoundedStringList(data.features, 20) &&
        data.isRecommended is bool &&
        data.isActive is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 100 &&
        data.updatedAt is timestamp;
    }

    function isValidSaasTenantSubscription(data) {
      return data.keys().hasAll(['organizationId', 'organizationName', 'organizationSlug', 'industry', 'ownerId', 'ownerName', 'ownerEmail', 'billingPhone', 'planId', 'planName', 'requestedPlanId', 'billingCycle', 'currency', 'mrrEtb', 'mrrUsd', 'status', 'paymentMethod', 'paymentReference', 'trialEndsAt', 'currentPeriodEnd', 'maxBusinessUnits', 'maxForms', 'maxLeads', 'maxStaffSeats', 'adminNotes', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['organizationId', 'organizationName', 'organizationSlug', 'industry', 'ownerId', 'ownerName', 'ownerEmail', 'billingPhone', 'planId', 'planName', 'requestedPlanId', 'billingCycle', 'currency', 'mrrEtb', 'mrrUsd', 'status', 'paymentMethod', 'paymentReference', 'trialEndsAt', 'currentPeriodEnd', 'maxBusinessUnits', 'maxForms', 'maxLeads', 'maxStaffSeats', 'adminNotes', 'authorizedUserIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.organizationId) &&
        isNonEmptyString(data.organizationName, 140) &&
        isValidSlug(data.organizationSlug) &&
        isBoundedString(data.industry, 100) &&
        isValidId(data.ownerId) &&
        isBoundedString(data.ownerName, 140) &&
        isBoundedString(data.ownerEmail, 200) &&
        isBoundedString(data.billingPhone, 60) &&
        isNonEmptyString(data.planId, 128) &&
        isNonEmptyString(data.planName, 100) &&
        isBoundedString(data.requestedPlanId, 128) &&
        data.billingCycle in ['monthly', 'annual'] &&
        data.currency in ['ETB', 'USD'] &&
        data.mrrEtb is number && data.mrrEtb >= 0 && data.mrrEtb <= 10000000 &&
        data.mrrUsd is number && data.mrrUsd >= 0 && data.mrrUsd <= 100000 &&
        data.status in ['trial', 'active', 'past_due', 'suspended', 'cancelled'] &&
        data.paymentMethod in ['trial', 'telebirr', 'cbe_bank', 'chapa_card', 'stripe_card', 'invoice'] &&
        isBoundedString(data.paymentReference, 140) &&
        isBoundedString(data.trialEndsAt, 40) &&
        isBoundedString(data.currentPeriodEnd, 40) &&
        data.maxBusinessUnits is number && data.maxBusinessUnits >= 1 && data.maxBusinessUnits <= 10000 &&
        data.maxForms is number && data.maxForms >= 1 && data.maxForms <= 100000 &&
        data.maxLeads is number && data.maxLeads >= 1 && data.maxLeads <= 10000000 &&
        data.maxStaffSeats is number && data.maxStaffSeats >= 1 && data.maxStaffSeats <= 10000 &&
        isBoundedString(data.adminNotes, 1500) &&
        isBoundedStringList(data.authorizedUserIds, 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSaasInvoice(data) {
      return data.keys().hasAll(['id', 'invoiceNumber', 'organizationId', 'organizationName', 'ownerId', 'planId', 'planName', 'billingCycle', 'amountEtb', 'amountUsd', 'paymentMethod', 'paymentReference', 'status', 'notes', 'issuedAt', 'paidAt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'invoiceNumber', 'organizationId', 'organizationName', 'ownerId', 'planId', 'planName', 'billingCycle', 'amountEtb', 'amountUsd', 'paymentMethod', 'paymentReference', 'status', 'notes', 'issuedAt', 'paidAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.invoiceNumber, 40) &&
        isValidId(data.organizationId) &&
        isNonEmptyString(data.organizationName, 140) &&
        isValidId(data.ownerId) &&
        isNonEmptyString(data.planId, 128) &&
        isNonEmptyString(data.planName, 100) &&
        data.billingCycle in ['monthly', 'annual'] &&
        data.amountEtb is number && data.amountEtb >= 0 && data.amountEtb <= 100000000 &&
        data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 1000000 &&
        data.paymentMethod in ['telebirr', 'cbe_bank', 'chapa_card', 'stripe_card', 'invoice'] &&
        isBoundedString(data.paymentReference, 140) &&
        data.status in ['pending_verification', 'paid', 'void'] &&
        isBoundedString(data.notes, 800) &&
        isNonEmptyString(data.issuedAt, 40) &&
        isBoundedString(data.paidAt, 40) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSaasSalesInquiry(data) {
      return data.keys().hasAll(['id', 'companyName', 'contactName', 'email', 'phone', 'industry', 'branchCount', 'interestedPlan', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'companyName', 'contactName', 'email', 'phone', 'industry', 'branchCount', 'interestedPlan', 'message', 'status', 'createdAt']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.companyName, 140) &&
        isNonEmptyString(data.contactName, 140) &&
        isBoundedString(data.email, 200) &&
        isBoundedString(data.phone, 60) &&
        isBoundedString(data.industry, 100) &&
        isBoundedString(data.branchCount, 40) &&
        isBoundedString(data.interestedPlan, 100) &&
        isBoundedString(data.message, 1500) &&
        data.status in ['new', 'contacted', 'converted', 'closed'] &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // PUBLIC FORM & AI SUPPORT HELPERS
    // =========================================================================

    function isActivePublicForm(slugKey, orgId, buId, formId) {
      return isValidPublicKey(slugKey) &&
        exists(/databases/$(database)/documents/publicForms/$(slugKey)) &&
        get(/databases/$(database)/documents/publicForms/$(slugKey)).data.isPublished == true &&
        get(/databases/$(database)/documents/publicForms/$(slugKey)).data.isActive == true &&
        get(/databases/$(database)/documents/publicForms/$(slugKey)).data.organizationId == orgId &&
        get(/databases/$(database)/documents/publicForms/$(slugKey)).data.businessUnitId == buId &&
        get(/databases/$(database)/documents/publicForms/$(slugKey)).data.formId == formId;
    }

    function isActivePublicSupport(orgId) {
      return isValidId(orgId) &&
        exists(/databases/$(database)/documents/publicSupport/$(orgId)) &&
        get(/databases/$(database)/documents/publicSupport/$(orgId)).data.isActive == true;
    }

    function publicSupportOwner(orgId) {
      return get(/databases/$(database)/documents/publicSupport/$(orgId)).data.orgOwnerId;
    }

    // =========================================================================
    // USERS COLLECTION (PII ISOLATED TO OWNER OR BOOTSTRAP SUPER ADMIN)
    // =========================================================================

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId ||
        isBootstrapSuperAdmin() ||
        isOrgSuperOrAdmin(existing().organizationId)
      );
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(userId) && isSignedIn() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isBootstrapSuperAdmin() || (
            isOrgSuperOrAdmin(incoming().organizationId) &&
            incoming().role != 'super_admin'
          ) || (
            isVerifiedUser() &&
            request.auth.uid == userId &&
            incoming().role == 'staff' &&
            incoming().crmAccess == false
          )
        );
      allow update: if isValidId(userId) && isSignedIn() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isBootstrapSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'username', 'phone', 'organizationId', 'role', 'crmAccess', 'status', 'mustChangePassword', 'lastLoginAt', 'updatedAt'])) ||
          (
            isOrgSuperOrAdmin(existing().organizationId) &&
            incoming().organizationId == existing().organizationId &&
            incoming().role != 'super_admin' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'username', 'phone', 'role', 'crmAccess', 'status', 'mustChangePassword', 'updatedAt'])
          ) ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'mustChangePassword', 'lastLoginAt', 'updatedAt'])) ||
          (
            isVerifiedUser() &&
            request.auth.uid == userId &&
            incoming().role == 'super_admin' &&
            incoming().crmAccess == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'organizationId', 'role', 'crmAccess', 'updatedAt']) &&
            existsAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId)) &&
            getAfter(/databases/$(database)/documents/organizations/$(incoming().organizationId)).data.ownerId == request.auth.uid
          )
        );
      allow delete: if isValidId(userId) && isSignedIn() && userId != request.auth.uid && (
        isBootstrapSuperAdmin() ||
        (isOrgSuperOrAdmin(existing().organizationId) && existing().role != 'super_admin')
      );
    }

    // =========================================================================
    // USERNAME LOOKUP INDEX (EXACT-MATCH GET FOR LOGIN; ADMIN-MANAGED WRITES)
    // =========================================================================

    match /usernameLookup/{username} {
      allow get: if isValidUsername(username);
      allow list: if isSignedIn() && canReadOrgRecord(existing());
      allow create: if isValidUsername(username) && isSignedIn() &&
        isValidUsernameLookup(incoming()) &&
        incoming().username == username &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(incoming().organizationId);
      allow update: if isValidUsername(username) && isSignedIn() &&
        isValidUsernameLookup(incoming()) &&
        incoming().username == existing().username &&
        incoming().uid == existing().uid &&
        incoming().organizationId == existing().organizationId &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(existing().organizationId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['loginEmail', 'status', 'authorizedUserIds', 'updatedAt']);
      allow delete: if isValidUsername(username) && isSignedIn() &&
        isOrgSuperOrAdmin(existing().organizationId);
    }

    // =========================================================================
    // COMMERCIAL SAAS PLATFORM: PLANS, TENANT SUBSCRIPTIONS, INVOICES & SALES
    // =========================================================================

    match /saasPlans/{planId} {
      allow get: if isValidId(planId) && (
        existing().isActive == true || isBootstrapSuperAdmin()
      );
      allow list: if existing().isActive == true || isBootstrapSuperAdmin();
      allow create: if isValidId(planId) && isBootstrapSuperAdmin() &&
        isValidSaasPlan(incoming()) &&
        incoming().id == planId &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(planId) && isBootstrapSuperAdmin() &&
        isValidSaasPlan(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'audience', 'tagline', 'monthlyPriceEtb', 'monthlyPriceUsd', 'annualDiscountPercent', 'maxBusinessUnits', 'maxForms', 'maxLeads', 'maxStaffSeats', 'includesAiSupport', 'includesSmsEmailAi', 'includesWhiteLabel', 'features', 'isRecommended', 'isActive', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(planId) && isBootstrapSuperAdmin();
    }

    match /saasTenants/{organizationId} {
      allow get: if isValidId(organizationId) && canReadOrgRecord(existing());
      allow list: if isSignedIn() && canReadOrgRecord(existing());
      allow create: if isValidId(organizationId) && isVerifiedUser() &&
        isValidSaasTenantSubscription(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/organizations/$(organizationId)) && (
          isBootstrapSuperAdmin() || (
            incoming().ownerId == request.auth.uid &&
            request.auth.uid in incoming().authorizedUserIds &&
            incoming().status == 'trial' &&
            getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerId == request.auth.uid
          )
        );
      allow update: if isValidId(organizationId) && isVerifiedUser() &&
        isValidSaasTenantSubscription(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isBootstrapSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['organizationName', 'industry', 'ownerName', 'ownerEmail', 'billingPhone', 'planId', 'planName', 'requestedPlanId', 'billingCycle', 'currency', 'mrrEtb', 'mrrUsd', 'status', 'paymentMethod', 'paymentReference', 'trialEndsAt', 'currentPeriodEnd', 'maxBusinessUnits', 'maxForms', 'maxLeads', 'maxStaffSeats', 'adminNotes', 'authorizedUserIds', 'updatedAt'])
          ) || (
            existing().ownerId == request.auth.uid &&
            existing().status != 'suspended' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['organizationName', 'industry', 'billingPhone', 'requestedPlanId', 'billingCycle', 'currency', 'paymentMethod', 'paymentReference', 'updatedAt'])
          )
        );
      allow delete: if isValidId(organizationId) && isBootstrapSuperAdmin();
    }

    match /saasInvoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (
        isBootstrapSuperAdmin() ||
        (isSignedIn() && existing().ownerId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isBootstrapSuperAdmin() ||
        existing().ownerId == request.auth.uid
      );
      allow create: if isValidId(invoiceId) && isVerifiedUser() &&
        isValidSaasInvoice(incoming()) &&
        incoming().id == invoiceId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/saasTenants/$(incoming().organizationId)) && (
          isBootstrapSuperAdmin() || (
            incoming().ownerId == request.auth.uid &&
            incoming().status == 'pending_verification' &&
            incoming().paidAt == '' &&
            get(/databases/$(database)/documents/saasTenants/$(incoming().organizationId)).data.ownerId == request.auth.uid
          )
        );
      allow update: if isValidId(invoiceId) && isBootstrapSuperAdmin() &&
        isValidSaasInvoice(incoming()) &&
        incoming().id == existing().id &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentReference', 'paymentMethod', 'notes', 'paidAt', 'updatedAt']);
      allow delete: if false;
    }

    match /saasSalesInquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isBootstrapSuperAdmin();
      allow list: if isBootstrapSuperAdmin();
      allow create: if isValidId(inquiryId) &&
        isValidSaasSalesInquiry(incoming()) &&
        incoming().id == inquiryId &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(inquiryId) && isBootstrapSuperAdmin() &&
        isValidSaasSalesInquiry(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(inquiryId) && isBootstrapSuperAdmin();
    }

    // =========================================================================
    // PUBLIC FORMS PROJECTION (SANITIZED PUBLIC GET ONLY — NO LISTING)
    // =========================================================================

    match /publicForms/{publicSlugKey} {
      allow get: if isValidPublicKey(publicSlugKey) && (
        (existing().isPublished == true && existing().isActive == true) ||
        isBootstrapSuperAdmin() ||
        (isSignedIn() && existing().orgOwnerId == request.auth.uid)
      );
      allow list: if false;
      allow create: if isValidPublicKey(publicSlugKey) && isSignedIn() &&
        isValidPublicFormProjection(incoming()) &&
        incoming().publicSlugKey == publicSlugKey &&
        incoming().updatedAt == request.time && (
          isOrgSuperOrAdmin(incoming().organizationId) ||
          isBuManagerFor(incoming().organizationId, incoming().businessUnitId)
        );
      allow update: if isValidPublicKey(publicSlugKey) && isSignedIn() &&
        isValidPublicFormProjection(incoming()) &&
        incoming().publicSlugKey == existing().publicSlugKey &&
        incoming().organizationId == existing().organizationId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['businessUnitName', 'title', 'description', 'fields', 'isPublished', 'isActive', 'submissionLimit', 'confirmationMessage', 'brandColor', 'logoUrl', 'updatedAt']) && (
          isOrgSuperOrAdmin(existing().organizationId) ||
          isBuManagerFor(existing().organizationId, existing().businessUnitId)
        );
      allow delete: if isValidPublicKey(publicSlugKey) && isSignedIn() && (
        isOrgSuperOrAdmin(existing().organizationId) ||
        isBuManagerFor(existing().organizationId, existing().businessUnitId)
      );
    }

    // =========================================================================
    // SECTION 8: PUBLIC AI SUPPORT CONFIG, COURSES & KNOWLEDGE BASE
    // =========================================================================

    match /publicSupport/{organizationId} {
      allow get: if isValidId(organizationId);
      allow list: if false;
      allow create: if isValidId(organizationId) && isSignedIn() &&
        isValidPublicSupportConfig(incoming()) &&
        incoming().organizationId == organizationId &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(organizationId);
      allow update: if isValidId(organizationId) && isSignedIn() &&
        isValidPublicSupportConfig(incoming()) &&
        incoming().organizationId == existing().organizationId &&
        incoming().orgOwnerId == existing().orgOwnerId &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(organizationId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'assistantName', 'welcomeMessage', 'aiInstructions', 'supportedLanguages', 'trainingInstituteBuId', 'trainingInstituteName', 'registrationFormUrl', 'updatedAt']);
      allow delete: if false;
    }

    match /publicCourses/{courseId} {
      allow get: if isValidId(courseId) && (
        existing().isActive == true || canReadOrgRecord(existing())
      );
      allow list: if existing().isActive == true || (isSignedIn() && canReadOrgRecord(existing()));
      allow create: if isValidId(courseId) && isSignedIn() &&
        isValidTrainingCourse(incoming()) &&
        incoming().id == courseId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(incoming().organizationId);
      allow update: if isValidId(courseId) && isSignedIn() &&
        isValidTrainingCourse(incoming()) &&
        incoming().id == existing().id &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(existing().organizationId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'description', 'learningObjectives', 'qualifications', 'duration', 'deliveryMethods', 'schedules', 'availableBatches', 'certificateInfo', 'approvedFee', 'registrationProcedure', 'isActive', 'authorizedUserIds', 'updatedAt']);
      allow delete: if isValidId(courseId) && isSignedIn() &&
        isOrgSuperOrAdmin(existing().organizationId);
    }

    match /publicFaqs/{faqId} {
      allow get: if isValidId(faqId) && (
        existing().isActive == true || canReadOrgRecord(existing())
      );
      allow list: if existing().isActive == true || (isSignedIn() && canReadOrgRecord(existing()));
      allow create: if isValidId(faqId) && isSignedIn() &&
        isValidSupportKnowledge(incoming()) &&
        incoming().id == faqId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(incoming().organizationId);
      allow update: if isValidId(faqId) && isSignedIn() &&
        isValidSupportKnowledge(incoming()) &&
        incoming().id == existing().id &&
        incoming().organizationId == existing().organizationId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(existing().organizationId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['category', 'question', 'answer', 'language', 'isActive', 'authorizedUserIds', 'updatedAt']);
      allow delete: if isValidId(faqId) && isSignedIn() &&
        isOrgSuperOrAdmin(existing().organizationId);
    }

    // =========================================================================
    // ORGANIZATIONS & MULTI-TENANT SUBCOLLECTIONS
    // =========================================================================

    match /organizations/{organizationId} {
      allow get: if isValidId(organizationId) && (canReadOrgRecord(existing()) || isMemberActive(organizationId));
      allow list: if isSignedIn() && canReadOrgRecord(existing());
      allow create: if isValidId(organizationId) && isVerifiedUser() &&
        isValidOrganization(incoming()) &&
        incoming().id == organizationId &&
        incoming().ownerId == request.auth.uid &&
        request.auth.uid in incoming().authorizedUserIds &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(organizationId) && isSignedIn() &&
        isValidOrganization(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isOrgSuperOrAdmin(organizationId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'primaryColor', 'secondaryColor', 'duplicateMatchMode', 'authorizedUserIds', 'updatedAt']);
      allow delete: if false;

      // -----------------------------------------------------------------------
      // ORGANIZATION MEMBERS (RBAC)
      // -----------------------------------------------------------------------
      match /members/{userId} {
        allow get: if isValidId(organizationId) && isValidId(userId) && isSignedIn() && (
          request.auth.uid == userId || canReadOrgRecord(existing())
        );
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(userId) && isSignedIn() &&
          isValidOrgMember(incoming()) &&
          incoming().organizationId == organizationId &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/organizations/$(organizationId)) && (
            isOrgSuperOrAdmin(organizationId) || (
              isVerifiedUser() &&
              request.auth.uid == userId &&
              incoming().role == 'super_admin' &&
              getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerId == request.auth.uid
            )
          );
        allow update: if isValidId(organizationId) && isValidId(userId) && isSignedIn() &&
          isValidOrgMember(incoming()) &&
          incoming().organizationId == existing().organizationId &&
          incoming().userId == existing().userId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (
              isOrgSuperOrAdmin(organizationId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'username', 'phone', 'role', 'crmAccess', 'permissions', 'mustChangePassword', 'lastLoginAt', 'assignedBusinessUnitIds', 'status', 'authorizedUserIds', 'updatedAt'])
            ) || (
              request.auth.uid == userId &&
              isMemberActive(organizationId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'mustChangePassword', 'lastLoginAt', 'updatedAt'])
            )
          );
        allow delete: if isValidId(organizationId) && isValidId(userId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId) &&
          userId != request.auth.uid;
      }

      // -----------------------------------------------------------------------
      // LOGIN ACTIVITY & SECURITY AUDIT LOG (IMMUTABLE APPEND-ONLY)
      // -----------------------------------------------------------------------
      match /loginActivity/{eventId} {
        allow get: if isValidId(organizationId) && isValidId(eventId) && isSignedIn() && (
          canReadOrgRecord(existing()) || existing().userId == request.auth.uid
        );
        allow list: if isSignedIn() && (
          canReadOrgRecord(existing()) || existing().userId == request.auth.uid
        );
        allow create: if isValidId(organizationId) && isValidId(eventId) && isSignedIn() &&
          isValidLoginActivity(incoming()) &&
          incoming().id == eventId &&
          incoming().organizationId == organizationId &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time && (
            isBootstrapSuperAdmin() || hasMemberDoc(organizationId)
          );
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // BUSINESS UNITS
      // -----------------------------------------------------------------------
      match /businessUnits/{businessUnitId} {
        allow get: if isValidId(organizationId) && isValidId(businessUnitId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(businessUnitId) && isSignedIn() &&
          isValidBusinessUnit(incoming()) &&
          incoming().id == businessUnitId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/organizations/$(organizationId)) &&
          isOrgSuperOrAdmin(organizationId);
        allow update: if isValidId(organizationId) && isValidId(businessUnitId) && isSignedIn() &&
          isValidBusinessUnit(incoming()) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (isOrgSuperOrAdmin(organizationId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'category', 'services', 'logoUrl', 'brandColor', 'contactEmail', 'phoneNumber', 'physicalAddress', 'website', 'assignedAdminIds', 'assignedStaffIds', 'status', 'authorizedUserIds', 'updatedAt'])) ||
            (isBuManagerFor(organizationId, businessUnitId) && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'services', 'logoUrl', 'brandColor', 'contactEmail', 'phoneNumber', 'physicalAddress', 'website', 'assignedStaffIds', 'updatedAt']))
          );
        allow delete: if isValidId(organizationId) && isValidId(businessUnitId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);

        // ---------------------------------------------------------------------
        // DYNAMIC FORMS UNDER BUSINESS UNIT
        // ---------------------------------------------------------------------
        match /forms/{formId} {
          allow get: if isValidId(organizationId) && isValidId(businessUnitId) && isValidId(formId) && canReadOrgRecord(existing());
          allow list: if isSignedIn() && canReadOrgRecord(existing());
          allow create: if isValidId(organizationId) && isValidId(businessUnitId) && isValidId(formId) && isSignedIn() &&
            isValidDynamicForm(incoming()) &&
            incoming().id == formId &&
            incoming().organizationId == organizationId &&
            incoming().businessUnitId == businessUnitId &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            exists(/databases/$(database)/documents/organizations/$(organizationId)/businessUnits/$(businessUnitId)) && (
              isOrgSuperOrAdmin(organizationId) ||
              isBuManagerFor(organizationId, businessUnitId)
            );
          allow update: if isValidId(organizationId) && isValidId(businessUnitId) && isValidId(formId) && isSignedIn() &&
            isValidDynamicForm(incoming()) &&
            incoming().id == existing().id &&
            incoming().organizationId == existing().organizationId &&
            incoming().businessUnitId == existing().businessUnitId &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time && (
              isOrgSuperOrAdmin(organizationId) ||
              isBuManagerFor(organizationId, businessUnitId)
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slug', 'publicSlugKey', 'businessUnitName', 'description', 'fields', 'isPublished', 'isActive', 'submissionLimit', 'submissionCount', 'confirmationMessage', 'brandColor', 'logoUrl', 'aiPrompt', 'authorizedUserIds', 'updatedAt']);
          allow delete: if isValidId(organizationId) && isValidId(businessUnitId) && isValidId(formId) && isSignedIn() && (
            isOrgSuperOrAdmin(organizationId) ||
            isBuManagerFor(organizationId, businessUnitId)
          );
        }
      }

      // -----------------------------------------------------------------------
      // FORM SUBMISSIONS (PUBLIC CREATE VALIDATED AGAINST ACTIVE PUBLIC FORM)
      // -----------------------------------------------------------------------
      match /formSubmissions/{submissionId} {
        allow get: if isValidId(organizationId) && isValidId(submissionId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(submissionId) &&
          isValidFormSubmission(incoming()) &&
          incoming().id == submissionId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time && (
            (
              incoming().source == 'public_form' &&
              isActivePublicForm(incoming().publicSlugKey, organizationId, incoming().businessUnitId, incoming().formId) &&
              incoming().ownerId == get(/databases/$(database)/documents/publicForms/$(incoming().publicSlugKey)).data.orgOwnerId &&
              incoming().authorizedUserIds.size() == 1 &&
              incoming().authorizedUserIds[0] == incoming().ownerId
            ) || (
              isSignedIn() && isStaffForOrg(organizationId)
            )
          );
        allow update: if false;
        allow delete: if isValidId(organizationId) && isValidId(submissionId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);
      }

      // -----------------------------------------------------------------------
      // CENTRALIZED CRM LEADS (ATOMIC PUBLIC CREATE + TIERED RBAC UPDATES)
      // -----------------------------------------------------------------------
      match /leads/{leadId} {
        allow get: if isValidId(organizationId) && isValidId(leadId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(leadId) &&
          isValidLead(incoming()) &&
          incoming().id == leadId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          incoming().submittedAt == request.time && (
            (
              incoming().source == 'public_form' &&
              incoming().status == 'new' &&
              incoming().priority == 'medium' &&
              incoming().assignedStaffId == '' &&
              incoming().assignedStaffName == '' &&
              isActivePublicForm(incoming().publicSlugKey, organizationId, incoming().businessUnitId, incoming().formId) &&
              incoming().ownerId == get(/databases/$(database)/documents/publicForms/$(incoming().publicSlugKey)).data.orgOwnerId &&
              incoming().authorizedUserIds.size() == 1 &&
              incoming().authorizedUserIds[0] == incoming().ownerId &&
              existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/formSubmissions/$(incoming().submissionId))
            ) || (
              incoming().source == 'ai_chat' &&
              incoming().status == 'new' &&
              incoming().priority == 'medium' &&
              incoming().assignedStaffId == '' &&
              incoming().assignedStaffName == '' &&
              isActivePublicSupport(organizationId) &&
              incoming().ownerId == publicSupportOwner(organizationId) &&
              incoming().authorizedUserIds.size() == 1 &&
              incoming().authorizedUserIds[0] == incoming().ownerId &&
              existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/supportConversations/$(incoming().submissionId))
            ) || (
              isSignedIn() && isStaffForOrg(organizationId)
            )
          );
        allow update: if isValidId(organizationId) && isValidId(leadId) && isSignedIn() &&
          isValidLead(incoming()) &&
          incoming().id == existing().id &&
          incoming().leadRef == existing().leadRef &&
          incoming().organizationId == existing().organizationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().submittedAt == existing().submittedAt &&
          incoming().updatedAt == request.time && (
            // Tier 1: Super Admin / Org Admin / BU Manager full operational edit & assignment
            (
              (isOrgSuperOrAdmin(organizationId) || isBuManagerFor(organizationId, existing().businessUnitId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'phone', 'status', 'priority', 'assignedStaffId', 'assignedStaffName', 'followUpDate', 'lastContactAt', 'internalNotes', 'attachments', 'authorizedUserIds', 'updatedAt'])
            ) ||
            // Tier 2: Assigned Staff operational status/follow-up/notes updates (locked if archived unless admin)
            (
              isStaffForOrg(organizationId) &&
              existing().status != 'archived' &&
              (existing().assignedStaffId == request.auth.uid || request.auth.uid in existing().authorizedUserIds) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'followUpDate', 'lastContactAt', 'internalNotes', 'attachments', 'updatedAt'])
            )
          );
        allow delete: if isValidId(organizationId) && isValidId(leadId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);

        // ---------------------------------------------------------------------
        // LEAD ACTIVITIES (APPEND-ONLY TIMELINE)
        // ---------------------------------------------------------------------
        match /activities/{activityId} {
          allow get: if isValidId(organizationId) && isValidId(leadId) && isValidId(activityId) && canReadOrgRecord(existing());
          allow list: if isSignedIn() && canReadOrgRecord(existing());
          allow create: if isValidId(organizationId) && isValidId(leadId) && isValidId(activityId) &&
            isValidLeadActivity(incoming()) &&
            incoming().id == activityId &&
            incoming().organizationId == organizationId &&
            incoming().leadId == leadId &&
            incoming().createdAt == request.time && (
              (
                incoming().type == 'submission' &&
                incoming().actorId in ['public_visitor', 'ai_support_visitor'] &&
                !exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId)) &&
                existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId))
              ) || (
                isSignedIn() &&
                isStaffForOrg(organizationId) &&
                incoming().actorId == request.auth.uid &&
                existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId))
              )
            );
          allow update, delete: if false;
        }

        // ---------------------------------------------------------------------
        // LEAD COMMUNICATIONS HISTORY (APPEND-ONLY)
        // ---------------------------------------------------------------------
        match /communications/{communicationId} {
          allow get: if isValidId(organizationId) && isValidId(leadId) && isValidId(communicationId) && canReadOrgRecord(existing());
          allow list: if isSignedIn() && canReadOrgRecord(existing());
          allow create: if isValidId(organizationId) && isValidId(leadId) && isValidId(communicationId) && isSignedIn() &&
            isValidCommunication(incoming()) &&
            incoming().id == communicationId &&
            incoming().organizationId == organizationId &&
            incoming().leadId == leadId &&
            incoming().senderId == request.auth.uid &&
            incoming().createdAt == request.time &&
            isStaffForOrg(organizationId) &&
            exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId));
          allow update, delete: if false;
        }
      }

      // -----------------------------------------------------------------------
      // MESSAGE TEMPLATES
      // -----------------------------------------------------------------------
      match /messageTemplates/{templateId} {
        allow get: if isValidId(organizationId) && isValidId(templateId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(templateId) && isSignedIn() &&
          isValidMessageTemplate(incoming()) &&
          incoming().id == templateId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isStaffForOrg(organizationId);
        allow update: if isValidId(organizationId) && isValidId(templateId) && isSignedIn() &&
          isValidMessageTemplate(incoming()) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isStaffForOrg(organizationId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['businessUnitId', 'name', 'channel', 'subject', 'body', 'authorizedUserIds', 'updatedAt']);
        allow delete: if isValidId(organizationId) && isValidId(templateId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);
      }

      // -----------------------------------------------------------------------
      // STAFF ASSIGNMENTS
      // -----------------------------------------------------------------------
      match /staffAssignments/{assignmentId} {
        allow get: if isValidId(organizationId) && isValidId(assignmentId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(assignmentId) && isSignedIn() &&
          isValidStaffAssignment(incoming()) &&
          incoming().id == assignmentId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/organizations/$(organizationId)/businessUnits/$(incoming().businessUnitId)) &&
          isOrgSuperOrAdmin(organizationId);
        allow update: if false;
        allow delete: if isValidId(organizationId) && isValidId(assignmentId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);
      }

      // -----------------------------------------------------------------------
      // NOTIFICATIONS
      // -----------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get: if isValidId(organizationId) && isValidId(notificationId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(notificationId) &&
          isValidNotification(incoming()) &&
          incoming().id == notificationId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time && (
            (
              incoming().entityType == 'lead' &&
              !exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(incoming().entityId)) &&
              existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(incoming().entityId))
            ) || (
              incoming().entityType == 'followup' &&
              isActivePublicSupport(organizationId) &&
              incoming().ownerId == publicSupportOwner(organizationId) &&
              !exists(/databases/$(database)/documents/organizations/$(organizationId)/supportConversations/$(incoming().entityId)) &&
              existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/supportConversations/$(incoming().entityId))
            ) || (
              isSignedIn() && isStaffForOrg(organizationId)
            )
          );
        allow update: if isValidId(organizationId) && isValidId(notificationId) && isSignedIn() &&
          isValidNotification(incoming()) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          (existing().recipientUserId == request.auth.uid || isOrgSuperOrAdmin(organizationId)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isValidId(organizationId) && isValidId(notificationId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);
      }

      // -----------------------------------------------------------------------
      // AUDIT LOGS (IMMUTABLE APPEND-ONLY)
      // -----------------------------------------------------------------------
      match /auditLogs/{logId} {
        allow get: if isValidId(organizationId) && isValidId(logId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(logId) && isSignedIn() &&
          isValidAuditLog(incoming()) &&
          incoming().id == logId &&
          incoming().organizationId == organizationId &&
          incoming().actorId == request.auth.uid &&
          incoming().createdAt == request.time &&
          isStaffForOrg(organizationId);
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // INTEGRATIONS GOVERNANCE (SUPER ADMIN APPROVAL ONLY — NO SECRETS STORED)
      // -----------------------------------------------------------------------
      match /integrations/{integrationId} {
        allow get: if isValidId(organizationId) && isValidId(integrationId) && canReadOrgRecord(existing());
        allow list: if isSignedIn() && canReadOrgRecord(existing());
        allow create: if isValidId(organizationId) && isValidId(integrationId) && isSignedIn() &&
          isValidIntegrationConfig(incoming()) &&
          incoming().id == integrationId &&
          incoming().organizationId == organizationId &&
          incoming().updatedAt == request.time &&
          isOrgSuperOrAdmin(organizationId);
        allow update: if isValidId(organizationId) && isValidId(integrationId) && isSignedIn() &&
          isValidIntegrationConfig(incoming()) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().providerKey == existing().providerKey &&
          incoming().ownerId == existing().ownerId &&
          incoming().updatedAt == request.time &&
          isOrgSuperOrAdmin(organizationId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['approvalStatus', 'approvedBy', 'estimatedCost', 'purpose', 'authorizedUserIds', 'updatedAt']);
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // SECTION 8: AI SUPPORT CONVERSATIONS (PRIVACY-ISOLATED)
      // -----------------------------------------------------------------------
      match /supportConversations/{conversationId} {
        allow get: if isValidId(organizationId) && isValidId(conversationId) && (
          canReadOrgRecord(existing()) ||
          (isSignedIn() && existing().studentUid != '' && existing().studentUid == request.auth.uid)
        );
        allow list: if isSignedIn() && (
          canReadOrgRecord(existing()) ||
          (existing().studentUid != '' && existing().studentUid == request.auth.uid)
        );
        allow create: if isValidId(organizationId) && isValidId(conversationId) &&
          isValidSupportConversation(incoming()) &&
          incoming().id == conversationId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            (
              isActivePublicSupport(organizationId) &&
              incoming().ownerId == publicSupportOwner(organizationId) &&
              incoming().authorizedUserIds.size() == 1 &&
              incoming().authorizedUserIds[0] == incoming().ownerId &&
              incoming().assignedAgentId == '' &&
              incoming().assignedAgentName == '' &&
              incoming().status in ['active', 'escalated'] &&
              (incoming().studentUid == '' || (isSignedIn() && incoming().studentUid == request.auth.uid))
            ) || (
              isSignedIn() && isStaffForOrg(organizationId)
            )
          );
        allow update: if isValidId(organizationId) && isValidId(conversationId) && isSignedIn() &&
          isValidSupportConversation(incoming()) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (
              isStaffForOrg(organizationId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedAgentId', 'assignedAgentName', 'messages', 'unansweredQuestions', 'summary', 'leadId', 'leadRef', 'authorizedUserIds', 'updatedAt'])
            ) || (
              existing().studentUid != '' &&
              existing().studentUid == request.auth.uid &&
              incoming().studentUid == existing().studentUid &&
              incoming().status in ['active', 'escalated'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'summary', 'intent', 'interestedCourse', 'unansweredQuestions', 'status', 'updatedAt'])
            )
          );
        allow delete: if isValidId(organizationId) && isValidId(conversationId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);
      }

      // -----------------------------------------------------------------------
      // SECTION 8: STUDENT REGISTRATIONS (AUTHENTICATED STUDENT + STAFF ONLY)
      // -----------------------------------------------------------------------
      match /studentRegistrations/{registrationId} {
        allow get: if isValidId(organizationId) && isValidId(registrationId) && (
          canReadOrgRecord(existing()) ||
          (isSignedIn() && existing().studentUid != '' && existing().studentUid == request.auth.uid)
        );
        allow list: if isSignedIn() && (
          canReadOrgRecord(existing()) ||
          (existing().studentUid != '' && existing().studentUid == request.auth.uid)
        );
        allow create: if isValidId(organizationId) && isValidId(registrationId) &&
          isValidStudentRegistration(incoming()) &&
          incoming().id == registrationId &&
          incoming().organizationId == organizationId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            (
              incoming().source == 'ai_chat' &&
              incoming().registrationStatus == 'submitted' &&
              incoming().paymentStatus == 'pending' &&
              incoming().certificateStatus == 'not_issued' &&
              isActivePublicSupport(organizationId) &&
              incoming().ownerId == publicSupportOwner(organizationId) &&
              incoming().authorizedUserIds.size() == 1 &&
              incoming().authorizedUserIds[0] == incoming().ownerId &&
              (incoming().studentUid == '' || (isSignedIn() && incoming().studentUid == request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(incoming().leadId))
            ) || (
              isSignedIn() && isStaffForOrg(organizationId)
            )
          );
        allow update: if isValidId(organizationId) && isValidId(registrationId) && isSignedIn() &&
          isValidStudentRegistration(incoming()) &&
          incoming().id == existing().id &&
          incoming().organizationId == existing().organizationId &&
          incoming().leadId == existing().leadId &&
          incoming().leadRef == existing().leadRef &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isStaffForOrg(organizationId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['registrationStatus', 'batchName', 'classSchedule', 'trainingLocation', 'paymentStatus', 'certificateStatus', 'documentUploadFormUrl', 'authorizedUserIds', 'updatedAt']);
        allow delete: if isValidId(organizationId) && isValidId(registrationId) && isSignedIn() &&
          isOrgSuperOrAdmin(organizationId);
      }
    }
  }
}
